#!/bin/bash
# heimdall KILITLI sarmalayici — USB reset'i imkansiz kilar.
#
# Kurulum: bu betik /usr/bin/heimdall yerine gecer (kapi + kilit birlikte).
# Gercek ikili: /usr/libexec/heimdall/heimdall.elf
#
# Iki koruma birden:
#   1) OKUMA KAPISI: yazma yalnizca TTY + 'YAZ' onayi ile (bkz. heimdall-kapi)
#   2) RESET KILIDI: LD_PRELOAD ile libusb_reset_device 04e8:685d icin no-op
#
# Neden reset kilidi: bu cihazda libusb_reset_device zarar veriyor. Olculdu:
# reset sonrasi "urb status -2" (timeout) -> "Failed to send handshake".
# Kilit, kazara VEYA kasitli reset'i de etkisiz kilar.

set -u
ELF="/usr/libexec/heimdall/heimdall.elf"
KILIT="/usr/local/lib/libusb-reset-kilit.so"
ETIKET="heimdall-kapi"

izinli() {
  case "$1" in
    detect|print-pit|download-pit|info|version|help|--help|-h) return 0 ;;
    *) return 1 ;;
  esac
}

EYLEM=""
for a in "$@"; do
  case "$a" in
    --*|-*) continue ;;
    *) EYLEM="$a"; break ;;
  esac
done

TTY="yok"; { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; } && TTY="var"

# Reset kilidini her cagriya uygula (okuma da yazma da).
kilitli() {
  if [ -f "$KILIT" ]; then
    LD_PRELOAD="$KILIT${LD_PRELOAD:+:$LD_PRELOAD}" sudo -n "$ELF" "$@"
  else
    sudo -n "$ELF" "$@"
  fi
}

if [ -z "$EYLEM" ] || izinli "$EYLEM"; then
  logger -t "$ETIKET" "IZIN eylem=${EYLEM:-yok} tty=$TTY args=[$*]"
  kilitli "$@"
  exit $?
fi

if [ "$TTY" = "yok" ]; then
  logger -t "$ETIKET" "RED-TTY-YOK $EYLEM args=[$*]"
  {
    echo
    echo "  ⛔ heimdall YAZMA KAPISI — GERÇEK TERMİNAL YOK"
    echo "  İstenen eylem : $EYLEM"
    echo "  Yazma yalnızca kullanıcının KENDİ terminalinde yapılabilir."
    echo "  Cihaza HİÇBİR ŞEY yazılmadı.  journalctl -t heimdall-kapi"
    echo
  } >&2
  exit 13
fi

echo
echo "  ⚠ heimdall YAZMA — eylem: $EYLEM"
echo "  args: $*"
echo
read -r -p "  Onaylamak için tam olarak 'YAZ' yaz: " ONAY < /dev/tty
if [ "$ONAY" != "YAZ" ]; then
  logger -t "$ETIKET" "RED-ONAY-YOK $EYLEM"
  echo "  Onay verilmedi. Cihaza hiçbir şey yazılmadı." >&2
  exit 13
fi

logger -t "$ETIKET" "ONAYLI-YAZMA $EYLEM args=[$*]"
kilitli "$@"
