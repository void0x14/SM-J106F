diff --git a/sepolicy/freqctl.te b/sepolicy/freqctl.te
new file mode 100644
index 0000000..a8d37bf
--- /dev/null
+++ b/sepolicy/freqctl.te
@@ -0,0 +1,13 @@
+# inputfreq.sh / recoveryfreq.sh - termal bolge modu ve cooling device
+# durumunu ayarlayan kucuk kabuk betikleri. Ikisi de /system/bin/sh ile
+# kosar, sysfs'e yazar, /system/build.prop okur.
+type freqctl, domain;
+type freqctl_exec, exec_type, file_type;
+
+init_daemon_domain(freqctl)
+
+allow freqctl shell_exec:file { read open getattr execute execute_no_trans };
+allow freqctl system_file:file { read open getattr };
+allow freqctl sysfs:file { read open write getattr };
+allow freqctl system_data_file:dir search;
+allow freqctl proc:file { read open };
