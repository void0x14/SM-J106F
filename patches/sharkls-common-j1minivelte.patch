+# ext_data.sh - SC9830'in genel amacli script'i. Tek dosya, dort servis:
+#   data_on  -> -u   (IPv6/route/ifup)
+#   data_off -> -d   (ifdown, ip temizle)
+#   set_mac  -> -e   (DNS drop kurallari ekle)
+#   chown_service -> -c (DNS drop kurallari sil)
+# Hepsi /system/bin/sh ile kosar; iptables/ip/toybox cagirir.
+type ext_data, domain;
+type ext_data_exec, exec_type, file_type;
+
+init_daemon_domain(ext_data)
+
+allow ext_data shell_exec:file { read open getattr execute execute_no_trans };
+allow ext_data toolbox_exec:file { read open getattr execute execute_no_trans map };
+allow ext_data self:capability { net_admin net_raw };
+allow ext_data self:rawip_socket { create read write ioctl setopt };
+allow ext_data self:netlink_route_socket { create bind read write getattr nlmsg_read nlmsg_write };
+allow ext_data self:udp_socket { create read write ioctl };
+allow ext_data proc:file { read open };
+allow ext_data proc_net:file { read open getattr };
+allow ext_data sysfs:file { read open write };
+allow ext_data system_data_file:dir search;
