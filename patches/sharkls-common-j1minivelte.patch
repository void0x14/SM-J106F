diff --git a/rootdir/xbin/zram.sh b/rootdir/xbin/zram.sh
new file mode 100755
index 0000000..842e206
--- /dev/null
+++ b/rootdir/xbin/zram.sh
@@ -0,0 +1,45 @@
+#!/system/bin/sh
+#
+# J106F (j1minivelte) zram kurulumu.
+#
+# init bu betigi "on property:ro.config.zram.support=true" ile baslatir.
+# disksize, init.sc8830.rc icindeki "on property:ro.board_ram_size=<x>"
+# bloklarinda zram.disksize (MB) olarak set edilir.
+#
+# Cekirdek: drivers/staging/zram (CONFIG_ZRAM=y, CONFIG_ZSMALLOC=y).
+# Sysfs arayuzu (zram_sysfs.c):
+#   /sys/block/zram0/disksize      -> memparse() ile bayt (S_IRUGO|S_IWUSR)
+#   /sys/block/zram0/reset         -> write-only (S_IWUSR)
+#   /sys/block/zram0/mem_used_total, orig_data_size, compr_data_size -> R/O
+#
+# Not: disksize, cihaz init_done olmadan ONCE yazilmalidir; sonra yazmak
+# -EBUSY dondurur (zram_sysfs.c:disksize_store).
+
+ZRAM_DEV=/dev/block/zram0
+ZRAM_SYS=/sys/block/zram0
+
+# Disksize'i MB cinsinden oku (init setprop zram.disksize <MB>).
+SIZE_MB=$(/system/bin/getprop zram.disksize)
+if [ -z "$SIZE_MB" ]; then
+    SIZE_MB=400
+fi
+
+# Blok aygitini bekle / olustur.
+if [ ! -e "$ZRAM_DEV" ]; then
+    mkdir -p /dev/block
+    mknod "$ZRAM_DEV" b 253 0 2>/dev/null
+fi
+
+if [ ! -e "$ZRAM_DEV" ]; then
+    /system/bin/log -t zram "zram0 blok aygiti yok, cikiliyor"
+    exit 1
+fi
+
+# Disksize'i bayt olarak yaz (memparse kabul eder).
+echo $((SIZE_MB * 1024 * 1024)) > "$ZRAM_SYS/disksize"
+
+# Swap alanini olustur ve etkinlestir.
+/system/bin/mkswap "$ZRAM_DEV"
+/system/bin/swapon "$ZRAM_DEV"
+
+/system/bin/log -t zram "zram0 etkin: ${SIZE_MB}MB"
