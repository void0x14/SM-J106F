+# Strongswan VPN (charon) - IKEv2 daemon
+type charon, domain;
+type charon_exec, exec_type, file_type;
+
+init_daemon_domain(charon)
+
+allow charon self:capability { net_admin net_raw };
+allow charon self:udp_socket { create bind read write ioctl };
+allow charon self:tcp_socket { create bind read write ioctl };
+allow charon self:rawip_socket { create bind read write ioctl };
+allow charon self:netlink_route_socket { create bind read write getattr nlmsg_read };
+allow charon self:netlink_xfrm_socket { create bind read write getattr nlmsg_read };
+allow charon vpn_data_file:dir { read search write add_name remove_name open };
+allow charon vpn_data_file:file { read write open create getattr setattr unlink };
+allow charon system_data_file:dir search;
+allow charon kernel:system module_request;
+allow charon proc_net:file { read open getattr };
+allow charon sysfs:file { read open };
+allow charon proc:file read;
+allow charon netd:unix_stream_socket connectto;
